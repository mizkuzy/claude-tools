<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.claude-archiver</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__SCRIPT__</string>
    </array>

    <!-- Every 7 days of uptime. Not tied to a clock time, so it does
         not depend on the machine being awake at a specific moment. -->
    <key>StartInterval</key>
    <integer>604800</integer>

    <key>StandardOutPath</key>
    <string>__ARCHIVE__/launchd.out.log</string>

    <key>StandardErrorPath</key>
    <string>__ARCHIVE__/launchd.err.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
